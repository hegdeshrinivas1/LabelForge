# =====================================================
# LabelForge Backend Configuration
# =====================================================

# App Environment
ENVIRONMENT=development
APP_NAME=LabelForge
DEBUG=True

# Database Configuration
# Local SQLite default: sqlite:///./labelforge.db
# PostgreSQL for production: postgresql+psycopg2://postgres:postgres@localhost:5432/labelforge
DATABASE_URL=sqlite:///./labelforge.db

# Security & JWT
# Generated secret key for signing tokens (change in production!)
SECRET_KEY=labelforge_insecure_development_secret_key_change_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
# Restricted frontend origin(s) separated by commas
FRONTEND_URL=http://localhost:5173
